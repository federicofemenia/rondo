{
  "name": "rondo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter @rondo/api --filter @rondo/web dev",
    "dev:api": "pnpm --filter @rondo/api dev",
    "dev:web": "pnpm --filter @rondo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm exec eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "pnpm exec prettier --write .",
    "typecheck": "pnpm exec tsc -p tsconfig.base.json --noEmit",
    "prisma:generate": "pnpm --filter @rondo/api prisma:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.8"
  }
}
