NODE_ENV=development
# Local dev default. Render injects its own PORT at runtime — do not set
# PORT in the Render dashboard/render.yaml, and never hardcode it there.
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rondo
# Beta/production frontend origin, used for CORS and the CSRF Origin guard.
# Required when NODE_ENV=production. No trailing slash (e.g.
# https://rondo-beta.vercel.app, not .../) — a trailing slash is normalized
# internally, but set it clean regardless.
FRONTEND_URL=http://localhost:5173
# Native session-cookie auth (see docs/AUTHENTICATION.md). Both have safe
# defaults baked into config/env.ts (rondo_session / 30) -- only set these
# if you deliberately want to override them.
SESSION_COOKIE_NAME=rondo_session
SESSION_TTL_DAYS=30
# Cloudflare R2 (S3-compatible) avatar storage. Optional: leaving all of
# these unset disables avatar upload only (a clear "not available" message
# is shown to the user), the rest of the app is unaffected. See
# docs/AUTHENTICATION.md for how to set up an R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Web Push (VAPID). Required when NODE_ENV=production. Generate with
# `pnpm --filter @rondo/backend exec web-push generate-vapid-keys` -- see
# docs/WEB_PUSH.md for the full walkthrough. VAPID_PUBLIC_KEY must match
# VITE_VAPID_PUBLIC_KEY in the frontend's env (same key pair, public half).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URI, required by the Web Push protocol itself.
# Not a real inbox promise -- pick whatever address should receive abuse
# reports from push services (do not invent a fake domain in real deploys).
VAPID_SUBJECT=mailto:admin@rondo.app
