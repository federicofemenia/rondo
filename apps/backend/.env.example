NODE_ENV=development
# Local dev default. Render injects its own PORT at runtime — do not set
# PORT in the Render dashboard/render.yaml, and never hardcode it there.
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rondo
CLERK_SECRET_KEY=
# Not used by the backend at runtime; documented here only so a deployment
# checklist can set every Clerk-related variable from one place.
CLERK_PUBLISHABLE_KEY=
# Beta/production frontend origin, used for CORS. Required when NODE_ENV=production.
# No trailing slash (e.g. https://rondo-beta.vercel.app, not .../) — a
# trailing slash is normalized internally, but set it clean regardless.
FRONTEND_URL=http://localhost:5173
# Primary bootstrap source for the initial Señor Pato admin membership: the
# Clerk User ID of the account that should get it. Stable and unique
# regardless of auth strategy — never a real secret, but keep it backend-only.
BOOTSTRAP_ADMIN_CLERK_USER_ID=
# Dev-only convenience fallback (matched by username). Do not rely on this
# in beta/production — use BOOTSTRAP_ADMIN_CLERK_USER_ID instead.
BOOTSTRAP_ADMIN_USERNAME=
# Web Push (VAPID). Required when NODE_ENV=production. Generate with
# `pnpm --filter @rondo/backend exec web-push generate-vapid-keys` -- see
# docs/WEB_PUSH.md for the full walkthrough. VAPID_PUBLIC_KEY must match
# VITE_VAPID_PUBLIC_KEY in the frontend's env (same key pair, public half).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URI, required by the Web Push protocol itself.
# Not a real inbox promise -- pick whatever address should receive abuse
# reports from push services (do not invent a fake domain in real deploys).
VAPID_SUBJECT=mailto:admin@rondo.app
