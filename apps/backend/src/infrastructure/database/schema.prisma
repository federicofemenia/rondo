generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClubStatus {
  ACTIVE
  INACTIVE
}

enum ClubMembershipRole {
  MEMBER
  CLUB_ADMIN
}

enum ClubMembershipStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MatchStatus {
  ORGANIZING
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum StatusChangedByType {
  USER
  SYSTEM
}

enum MatchInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique @map("clerk_user_id")
  username    String?  @unique
  email       String?  @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships         ClubMembership[]
  organizedMatches    Match[]            @relation("MatchOrganizer")
  matchStatusChanges  Match[]            @relation("MatchStatusChangedBy")
  matchParticipations MatchParticipant[]
  ratingsGiven        PlayerRating[]     @relation("RatingAuthor")
  ratingsReceived     PlayerRating[]     @relation("RatingTarget")
  sportProfiles       UserSportProfile[]
  invitationsReceived MatchInvitation[]  @relation("InvitationInvitedUser")
  invitationsSent     MatchInvitation[]  @relation("InvitationInvitedBy")
  chatMessages        MatchChatMessage[]

  @@map("users")
}

model Club {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  address     String?
  city        String?
  province    String?
  timezone    String
  status      ClubStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  memberships  ClubMembership[]
  courts       Court[]
  openingHours OpeningHour[]
  news         ClubNews[]
  matches      Match[]

  @@map("clubs")
}

model ClubMembership {
  id         String               @id @default(uuid())
  clubId     String               @map("club_id")
  userId     String               @map("user_id")
  role       ClubMembershipRole   @default(MEMBER)
  status     ClubMembershipStatus @default(ACTIVE)
  isFavorite Boolean              @default(false) @map("is_favorite")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
  @@index([userId])
  @@map("club_memberships")
}

model Sport {
  id           String @id @default(uuid())
  code         String @unique
  name         String
  displayOrder Int    @map("display_order")

  modalities   SportModality[]
  userProfiles UserSportProfile[]

  @@map("sports")
}

model SportModality {
  id              String @id @default(uuid())
  sportId         String @map("sport_id")
  code            String @unique
  name            String
  playersCount    Int    @map("players_count")
  durationMinutes Int    @map("duration_minutes")
  displayOrder    Int    @map("display_order")

  sport   Sport   @relation(fields: [sportId], references: [id])
  courts  Court[]
  matches Match[]

  @@unique([sportId, name])
  @@index([sportId])
  @@map("sport_modalities")
}

model Court {
  id                  String   @id @default(uuid())
  clubId              String   @map("club_id")
  sportModalityId     String   @map("sport_modality_id")
  code                String
  name                String
  displayOrder        Int      @map("display_order")
  slotDurationMinutes Int      @map("slot_duration_minutes")
  pricePerHour        Decimal  @map("price_per_hour") @db.Decimal(10, 2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  club          Club          @relation(fields: [clubId], references: [id])
  sportModality SportModality @relation(fields: [sportModalityId], references: [id])
  matches       Match[]

  @@unique([clubId, code])
  @@index([clubId])
  @@index([sportModalityId])
  @@map("courts")
}

model OpeningHour {
  id        String    @id @default(uuid())
  clubId    String    @map("club_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  opensAt   String    @map("opens_at")
  closesAt  String    @map("closes_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, dayOfWeek])
  @@map("opening_hours")
}

model ClubNews {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  title     String
  message   String
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id])

  @@index([clubId])
  @@map("club_news")
}

model Match {
  id              String  @id @default(uuid())
  clubId          String? @map("club_id")
  sportModalityId String  @map("sport_modality_id")
  courtId         String? @map("court_id")
  organizerUserId String  @map("organizer_user_id")

  minPlayers Int      @map("min_players")
  maxPlayers Int      @map("max_players")
  positions  String[] @default([])

  scheduledDate            DateTime  @map("scheduled_date") @db.Date
  availabilityStartMinutes Int       @map("availability_start_minutes")
  availabilityEndMinutes   Int       @map("availability_end_minutes")
  startsAt                 DateTime? @map("starts_at")
  endsAt                   DateTime? @map("ends_at")

  status                MatchStatus         @default(ORGANIZING)
  statusChangedAt       DateTime            @map("status_changed_at")
  statusChangedByType   StatusChangedByType @map("status_changed_by_type")
  statusChangedByUserId String?             @map("status_changed_by_user_id")
  cancellationReason    String?             @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  club                Club?              @relation(fields: [clubId], references: [id])
  sportModality       SportModality      @relation(fields: [sportModalityId], references: [id])
  court               Court?             @relation(fields: [courtId], references: [id])
  organizer           User               @relation("MatchOrganizer", fields: [organizerUserId], references: [id])
  statusChangedByUser User?              @relation("MatchStatusChangedBy", fields: [statusChangedByUserId], references: [id])
  participants        MatchParticipant[]
  ratings             PlayerRating[]
  invitations         MatchInvitation[]
  chatMessages        MatchChatMessage[]

  @@index([clubId])
  @@index([sportModalityId])
  @@index([organizerUserId])
  @@index([status])
  @@index([endsAt])
  @@index([scheduledDate])
  @@map("matches")
}

model MatchParticipant {
  id          String   @id @default(uuid())
  matchId     String   @map("match_id")
  userId      String   @map("user_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_participants")
}

/// A real invitation from a match organizer to a candidate. One invitation per
/// (match, invited user) ever — the unique constraint below is permanent, so a
/// rejected or cancelled invitation cannot be re-sent to the same candidate.
model MatchInvitation {
  id            String                @id @default(uuid())
  matchId       String                @map("match_id")
  invitedUserId String                @map("invited_user_id")
  invitedById   String                @map("invited_by_id")
  position      String?
  status        MatchInvitationStatus @default(PENDING)
  respondedAt   DateTime?             @map("responded_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  match       Match @relation(fields: [matchId], references: [id])
  invitedUser User  @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id])
  invitedBy   User  @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@unique([matchId, invitedUserId])
  @@index([matchId])
  @@index([invitedUserId])
  @@map("match_invitations")
}

/// A single group chat per match, open to the organizer and confirmed
/// participants. Messages are never deleted or edited (MVP); when a user
/// loses access (leaves or is removed) their past messages stay visible.
model MatchChatMessage {
  id        String   @id @default(uuid())
  matchId   String   @map("match_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([matchId, createdAt])
  @@map("match_chat_messages")
}

model PlayerRating {
  id            String   @id @default(uuid())
  matchId       String   @map("match_id")
  authorUserId  String   @map("author_user_id")
  targetUserId  String   @map("target_user_id")
  gameplayScore Int      @map("gameplay_score")
  conductScore  Int      @map("conduct_score")
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  match  Match @relation(fields: [matchId], references: [id])
  author User  @relation("RatingAuthor", fields: [authorUserId], references: [id])
  target User  @relation("RatingTarget", fields: [targetUserId], references: [id])

  @@unique([matchId, authorUserId, targetUserId])
  @@index([matchId])
  @@index([targetUserId])
  @@map("player_ratings")
}

/// A user's sporting profile for a single sport: positions played and whether
/// they show up as available to receive invitations. One row per user+sport.
model UserSportProfile {
  id                        String   @id @default(uuid())
  userId                    String   @map("user_id")
  sportId                   String   @map("sport_id")
  positions                 String[] @default([])
  isAvailableForInvitations Boolean  @default(true) @map("is_available_for_invitations")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id])
  sport        Sport                @relation(fields: [sportId], references: [id])
  availability PlayerAvailability[]

  @@unique([userId, sportId])
  @@index([userId])
  @@index([sportId])
  @@map("user_sport_profiles")
}

/// A weekly recurring availability slot for a UserSportProfile. `dayOfWeek`
/// follows JS `Date#getUTCDay()` convention: 0 = Sunday ... 6 = Saturday.
/// `startMinutes`/`endMinutes` count minutes since 00:00 on that day.
model PlayerAvailability {
  id                 String   @id @default(uuid())
  userSportProfileId String   @map("user_sport_profile_id")
  dayOfWeek          Int      @map("day_of_week")
  startMinutes       Int      @map("start_minutes")
  endMinutes         Int      @map("end_minutes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userSportProfile UserSportProfile @relation(fields: [userSportProfileId], references: [id])

  @@unique([userSportProfileId, dayOfWeek, startMinutes, endMinutes])
  @@index([userSportProfileId])
  @@map("player_availabilities")
}
