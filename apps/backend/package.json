{
  "name": "@rondo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "predeploy": "pnpm prisma:generate && pnpm prisma:migrate:deploy",
    "seed:base": "tsx src/infrastructure/database/seedBase.ts",
    "seed:beta": "tsx src/infrastructure/database/seedBeta.ts",
    "seed:candidates": "tsx src/infrastructure/database/seedTestCandidates.ts",
    "prisma:seed": "tsx src/infrastructure/database/seed.ts",
    "auth:create-superadmin": "tsx src/infrastructure/scripts/createSuperadmin.ts",
    "beta:reset-user-data": "tsx src/infrastructure/scripts/resetUserData.ts"
  },
  "prisma": {
    "schema": "src/infrastructure/database/schema.prisma",
    "seed": "tsx src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.11.0",
    "@rondo/contracts": "workspace:*",
    "fastify": "^5.0.0",
    "prisma": "^5.11.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
