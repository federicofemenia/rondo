# Leave empty (default) to call the API via relative paths, proxied
# same-origin -- Vite's dev server proxy locally (see vite.config.ts),
# a Vercel rewrite in beta/production (see vercel.json). This is required
# for the httpOnly session cookie to work at all. Only set this to an
# absolute backend origin (no trailing slash, no /api/v1 suffix) if you're
# deliberately running the backend somewhere the proxy doesn't expect.
VITE_API_BASE_URL=
# Closed beta: keep this false (or unset) to hide "Crear cuenta" and show
# only Login. Set to the literal string "true" to allow self-registration.
VITE_BETA_SIGN_UP_ENABLED=false
# Web Push VAPID public key -- safe to expose in the frontend (it's the
# public half of the pair; the private half stays backend-only). Must match
# the backend's VAPID_PUBLIC_KEY exactly. See docs/WEB_PUSH.md.
VITE_VAPID_PUBLIC_KEY=
