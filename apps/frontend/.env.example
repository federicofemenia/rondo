# No trailing slash and no /api/v1 suffix — just the backend origin
# (e.g. https://rondo-backend.onrender.com). A trailing slash is
# normalized internally (see src/runtimeConfig.ts), but set it clean.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_CLERK_PUBLISHABLE_KEY=
# Closed beta: keep this false (or unset) to hide "Crear cuenta" and show
# only Login. Set to the literal string "true" to allow self-registration.
VITE_BETA_SIGN_UP_ENABLED=false
